<Window x:Class="VscodeSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VscodeSelector"
        Title="VS Code Selector" Icon="app.ico"
        Width="520" Height="384" MinWidth="188" MinHeight="62"
        UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="CanResize" Background="White"
        BorderBrush="#FFC8C8C8" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="4" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="5" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="6" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="7" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{x:Static local:MainWindow.ActivateIndexCommand}" CommandParameter="8" />
        <KeyBinding Key="Enter" Command="{x:Static local:MainWindow.ActivateFocusedCommand}" />
        <KeyBinding Key="Esc" Command="{x:Static local:MainWindow.MinimizeCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:EditionLabelConverter x:Key="EditionLabel" />
        <local:IdenticonConverter x:Key="Identicon" />
    </Window.Resources>
    <DockPanel x:Name="Root" LastChildFill="True">
        <!-- 短辺に置く擬似バー。向きはウィンドウの縦横比に応じて code-behind で切り替える。 -->
        <Border x:Name="GripBar" DockPanel.Dock="Left" Width="24" Background="#FFE4E4E4"
                Cursor="SizeAll" MouseLeftButtonDown="OnGripMouseDown">
            <Button x:Name="CloseButton" Width="24" Height="24" Content="✕" FontSize="11"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Arrow"
                    ToolTip="閉じる" AutomationProperties.Name="閉じる" Focusable="False" Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
        <!-- 余白もドラッグで移動できるよう Background で当たり判定を持たせる。 -->
        <Grid Background="Transparent" PreviewMouseLeftButtonDown="OnContentMouseDown">
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="EntriesList" ItemsSource="{Binding Entries}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- ItemWidth は右端の余白をなくすよう code-behind で一覧幅に合わせて Tag へ入れる。 -->
                            <WrapPanel ItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button MinWidth="150" Height="48" Margin="6"
                                    ToolTip="{Binding FullTitle}"
                                    AutomationProperties.Name="{Binding FullTitle}"
                                    HorizontalContentAlignment="Stretch" Padding="4,0"
                                    Click="OnEntryClick">
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,6,0"
                                           VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"
                                           Source="{Binding Converter={StaticResource Identicon}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock local:NameDecor.Entry="{Binding}" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Converter={StaticResource EditionLabel}}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Text="開いている VS Code がありません"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border x:Name="StatusBar" VerticalAlignment="Bottom" Background="#E0F0F0F0">
                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Margin="6,4"
                           TextTrimming="CharacterEllipsis" />
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </DockPanel>
</Window>
